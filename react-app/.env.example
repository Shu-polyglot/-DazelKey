# Copy to .env.local for local development. These are public browser values.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (Web application). Public by design (client-side token flow, no client
# secret involved) -- used to request a short-lived Calendar readonly
# access token in the browser, never sent to any backend.
VITE_GOOGLE_CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com
